{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-paste",
  "description": "The local quick panel can inspect and act on its current session.",
  "local": true,
  "windows": ["quick-paste"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-bootstrap",
    "allow-resize-auxiliary-corner",
    "allow-window-resize-available",
    "allow-start-window-resize",
    "allow-quick-paste-snapshot",
    "allow-select-quick-paste",
    "allow-expand-quick-paste",
    "allow-cancel-quick-paste"
  ]
}
