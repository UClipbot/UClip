{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray-menu",
  "description": "The local tray popup may change appearance and capture settings, open settings, or quit.",
  "local": true,
  "windows": ["tray-menu"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-bootstrap",
    "allow-update-settings",
    "allow-clipboard-status",
    "allow-update-capture-policy",
    "allow-open-settings-window",
    "allow-dismiss-tray-menu",
    "allow-quit-app"
  ]
}
