{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The local settings window may read and update settings and capture state.",
  "local": true,
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-bootstrap",
    "allow-update-settings",
    "allow-clipboard-status",
    "allow-update-capture-policy",
    "allow-desktop-status",
    "allow-update-desktop-preferences",
    "allow-update-key-bindings",
    "allow-set-autostart",
    "allow-close-main-window"
  ]
}
