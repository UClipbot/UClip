{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "hover-preview",
  "description": "The local hover preview may read its current content and close itself.",
  "local": true,
  "windows": [
    "hover-preview"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-bootstrap",
    "allow-window-theme-ready",
    "allow-clip-detail",
    "allow-get-hover-preview",
    "allow-hover-preview-presence",
    "allow-hide-hover-preview",
    "allow-is-window-maximized",
    "allow-toggle-window-maximized",
    "allow-start-window-drag",
    "allow-window-resize-available",
    "allow-start-window-resize",
    "allow-close-window"
  ]
}
