{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window may query history, update capture policy and request validated clipboard actions.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-bootstrap",
    "allow-window-theme-ready",
    "allow-get-settings",
    "allow-update-settings",
    "allow-sync-status",
    "allow-set-ui-language",
    "allow-history-query",
    "allow-clip-detail",
    "allow-clipboard-status",
    "allow-update-capture-policy",
    "allow-copy-clip",
    "allow-change-clip-deletion",
    "allow-purge-trash",
    "allow-change-clip-pin",
    "allow-deduplicate-pinned",
    "allow-collections-list",
    "allow-create-collection",
    "allow-rename-collection",
    "allow-delete-collection",
    "allow-transfer-clip",
    "allow-transfer-clips",
    "allow-editable-content",
    "allow-edit-clip",
    "allow-desktop-status",
    "allow-update-desktop-preferences",
    "allow-quick-paste-settings",
    "allow-update-quick-paste-settings",
    "allow-set-autostart",
    "allow-set-desktop-interaction",
    "allow-hide-main-window",
    "allow-minimize-window",
    "allow-is-window-maximized",
    "allow-toggle-window-maximized",
    "allow-start-window-drag",
    "allow-window-resize-available",
    "allow-start-window-resize",
    "allow-close-window",
    "allow-quit-app",
    "allow-create-text",
    "allow-update-key-bindings",
    "allow-open-settings-window",
    "allow-show-hover-preview",
    "allow-hide-hover-preview"
  ]
}
